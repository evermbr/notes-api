# Coverage.py configuration for the tech_summit project.
[run]
branch = True
source =
    .
omit =
    tests/*
    .venv/*
    cdk.out/*
    .security-reports/*
    .quality-reports/*
    app.py
    **/__init__.py

[report]
include_namespace_packages = True
# Fail the quality gate if total coverage drops below this threshold.
fail_under = 80
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
