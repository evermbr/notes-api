{
  "name": "deploy-agent",
  "description": "Kiro CLI deploy agent for a specifically requested tech_summit CDK stack. Never destroys resources.",
  "prompt": "file://./deploy-agent.prompt.md",
  "tools": ["read", "shell"],
  "allowedTools": ["read"],
  "resources": ["file://.kiro/steering/**/*.md"],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "cdk synth*",
          "cdk diff*",
          "cdk deploy*",
          "ACCOUNT_ID=* AWS_REGION=* cdk deploy*",
          "cdk ls*",
          "python3 -m venv*",
          "pip3 install*",
          "[ -d .venv ]*",
          "source .venv/bin/activate*",
          ". .venv/bin/activate*",
          "cat *",
          "ls *",
          "grep *",
          "echo *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "cdk destroy*",
          "aws *delete*",
          "aws *terminate*",
          "rm -rf *",
          "sudo *",
          "git push*"
        ],
        "effect": "deny"
      }
    ]
  }
}
