{
  "name": "python-quality-agent",
  "description": "Kiro CLI quality agent for the organization. Runs all standard quality checks for Python applications.",
  "prompt": "file://./quality-agent.prompt.md",
  "tools": ["read", "shell"],
  "allowedTools": ["read"],
  "resources": ["file://.kiro/steering/**/*.md"],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "[ -d .venv ]*",
          "python3 -m venv*",
          "pip3 install*",
          "mkdir *",
          "find *",
          "xargs *",
          "pylint *",
          "pytest*",
          "python3 -m pytest*",
          "python3 -m coverage*",
          "coverage *",
          "git diff*",
          "git log*",
          "git status*",
          "git show*",
          "source .venv/bin/activate*",
          ". .venv/bin/activate*",
          "cat *",
          "ls *",
          "grep *",
          "echo *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "cdk deploy*",
          "cdk destroy*",
          "aws *delete*",
          "aws *terminate*",
          "aws *put*",
          "aws *create*",
          "rm -rf *",
          "sudo *",
          "git push*"
        ],
        "effect": "deny"
      }
    ]
  }
}
