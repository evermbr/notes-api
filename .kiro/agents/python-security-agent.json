{
  "name": "python-security-agent",
  "description": "Kiro CLI security agent for Python applications.",
  "prompt": "file://./security-agent.prompt.md",
  "tools": ["read", "shell"],
  "allowedTools": ["read"],
  "resources": ["file://.kiro/steering/**/*.md"],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "[ -d .venv ]*",
          "python3 -m venv*",
          "pip3 install*",
          "bandit *",
          "pip-audit*",
          "gitleaks *",
          "git diff*",
          "git log*",
          "git status*",
          "git show*",
          "source .venv/bin/activate*",
          ". .venv/bin/activate*",
          "cat *",
          "ls *",
          "grep *",
          "echo *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "cdk deploy*",
          "cdk destroy*",
          "aws *delete*",
          "aws *terminate*",
          "aws *put*",
          "aws *create*",
          "rm -rf *",
          "sudo *",
          "git push*"
        ],
        "effect": "deny"
      }
    ]
  }
}
