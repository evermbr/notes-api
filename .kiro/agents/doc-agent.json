{
  "name": "doc-agent",
  "description": "Kiro agent that updates README.md only when documented behavior becomes stale.",
  "prompt": "file://./doc-agent.prompt.md",
  "tools": ["read", "shell", "write"],
  "allowedTools": ["read"],
  "resources": ["file://.kiro/steering/**/*.md"],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": ["README.md"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": ["**"],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git diff*",
          "git log*",
          "git status*",
          "git show*",
          "cat *",
          "ls *",
          "grep *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "cdk deploy*",
          "cdk destroy*",
          "aws *delete*",
          "aws *terminate*",
          "aws *put*",
          "aws *create*",
          "rm -rf *",
          "sudo *",
          "git push*",
          "git commit*"
        ],
        "effect": "deny"
      }
    ]
  }
}
